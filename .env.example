# Supabase — DB (Prisma)
# Transaction mode (앱 쿼리용, port 6543)
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection (마이그레이션용, port 5432)
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres"

# Supabase — Storage & Client
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# Auth.js
AUTH_SECRET=""     # openssl rand -base64 32
AUTH_URL="http://localhost:3000"

# Google OAuth (console.cloud.google.com)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Discord OAuth (discord.com/developers/applications)
AUTH_DISCORD_ID=""
AUTH_DISCORD_SECRET=""

# Anthropic (claude.ai 제목 자동 생성)
# console.anthropic.com → API Keys → Create key
ANTHROPIC_API_KEY=""

# Riot Games API (라이엇 계정 연동)
# developer.riotgames.com 로그인 → Development API Key (24시간 유효, 만료 시 재발급)
# 프로덕션 준비 시 Personal/Production API Key 신청 필요
RIOT_API_KEY=""
