generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ──────────────────────────────────────────────────────────
// ENUMS
// ──────────────────────────────────────────────────────────

enum Difficulty {
  easy
  medium
  hard
}

enum ComboStatus {
  draft
  published
  featured
  removed
}

enum OAuthProvider {
  google
  discord
}

enum NotificationType {
  like
  save
  comment
  share
}

enum UserRole {
  USER
  ADMIN
}

// ──────────────────────────────────────────────────────────
// USER
// ──────────────────────────────────────────────────────────

model User {
  id                  String         @id @default(cuid())
  // Auth.js standard fields
  name                String?
  email               String?        @unique
  emailVerified       DateTime?
  image               String?
  // Custom fields
  nickname            String?        @unique
  avatarUrl           String?
  oauthProvider       OAuthProvider?
  oauthId             String?
  onboardingCompleted Boolean        @default(false)
  role                UserRole       @default(USER)
  createdAt           DateTime       @default(now())
  // Riot account linking
  riotPuuid           String?
  riotGameName        String?
  riotTagLine         String?
  riotSummonerIconId  Int?
  riotSummonerId      String?
  riotTier            String?
  riotRank            String?
  riotLP              Int?
  riotTopMasteries    Json?

  combos      Combo[]
  likes       Like[]
  comments    Comment[]
  downloads   Download[]
  savedCombos SavedCombo[]

  receivedNotifications Notification[] @relation("NotificationRecipient")
  sentNotifications     Notification[] @relation("NotificationActor")

  reportsFiled    Report[] @relation("Reporter")
  reportsResolved Report[] @relation("Resolver")

  // Auth.js relations
  accounts Account[]
  sessions Session[]

  @@map("users")
}

// Auth.js required models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ──────────────────────────────────────────────────────────
// GAME & CHARACTER
// ──────────────────────────────────────────────────────────

model Game {
  id              String   @id @default(cuid())
  slug            String   @unique
  name            String
  iconUrl         String?
  currentPatch    String?
  inputCategories Json     @default("[]")
  createdAt       DateTime @default(now())

  characters Character[]
  combos     Combo[]

  @@map("games")
}

model Character {
  id      String  @id @default(cuid())
  gameId  String
  slug    String
  name    String
  iconUrl String?

  game   Game    @relation(fields: [gameId], references: [id])
  combos Combo[]

  @@unique([gameId, slug])
  @@map("characters")
}

// ──────────────────────────────────────────────────────────
// COMBO
// ──────────────────────────────────────────────────────────

model Combo {
  id            String      @id @default(cuid())
  title         String
  description   String?     @db.Text
  tip           String?     @db.Text
  authorId      String
  gameId        String
  characterId   String
  difficulty    Difficulty
  tags          String[]
  durationMs    Int?
  inputCount    Int         @default(0)
  inputSummary  Json        @default("[]")
  steps         Json        @default("[]")
  gameSpecific  Json        @default("{}")
  thumbnailUrl  String?
  videoUrl      String?
  videoCrop     Json?
  videoTrim     Json?
  tutfileUrl    String?
  patchVersion  String?
  viewCount     Int         @default(0)
  downloadCount Int         @default(0)
  likeCount     Int         @default(0)
  status        ComboStatus @default(published)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  author        User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  game          Game           @relation(fields: [gameId], references: [id])
  character     Character      @relation(fields: [characterId], references: [id])
  likes         Like[]
  comments      Comment[]
  downloads     Download[]
  savedBy       SavedCombo[]
  notifications Notification[]

  @@index([gameId, characterId])
  @@index([status, createdAt(sort: Desc)])
  @@index([status, likeCount(sort: Desc)])
  @@map("combos")
}

// ──────────────────────────────────────────────────────────
// INTERACTIONS
// ──────────────────────────────────────────────────────────

model Like {
  id        String   @id @default(cuid())
  userId    String
  comboId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  combo Combo @relation(fields: [comboId], references: [id], onDelete: Cascade)

  @@unique([userId, comboId])
  @@index([userId, comboId])
  @@map("likes")
}

model Comment {
  id        String   @id @default(cuid())
  comboId   String
  userId    String
  content   String   @db.Text
  createdAt DateTime @default(now())

  combo         Combo          @relation(fields: [comboId], references: [id], onDelete: Cascade)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  notifications Notification[]

  @@index([comboId, createdAt(sort: Desc)])
  @@map("comments")
}

model Download {
  id           String   @id @default(cuid())
  userId       String?
  comboId      String
  downloadedAt DateTime @default(now())

  user  User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  combo Combo @relation(fields: [comboId], references: [id], onDelete: Cascade)

  @@map("downloads")
}

model SavedCombo {
  id      String   @id @default(cuid())
  userId  String
  comboId String
  savedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  combo Combo @relation(fields: [comboId], references: [id], onDelete: Cascade)

  @@unique([userId, comboId])
  @@index([userId, savedAt(sort: Desc)])
  @@index([comboId])
  @@map("saved_combos")
}

// ──────────────────────────────────────────────────────────
// NOTIFICATIONS
// ──────────────────────────────────────────────────────────

model Notification {
  id          String           @id @default(cuid())
  recipientId String
  actorId     String
  type        NotificationType
  comboId     String
  commentId   String?
  readAt      DateTime?
  createdAt   DateTime         @default(now())

  recipient User     @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actor     User     @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)
  combo     Combo    @relation(fields: [comboId], references: [id], onDelete: Cascade)
  comment   Comment? @relation(fields: [commentId], references: [id], onDelete: SetNull)

  @@index([recipientId, readAt, createdAt(sort: Desc)])
  @@index([recipientId, actorId, comboId, type, createdAt])
  @@map("notifications")
}

// ──────────────────────────────────────────────────────────
// DESKTOP LOGIN NONCE (auto-pickup token flow)
// ──────────────────────────────────────────────────────────

model DesktopLoginNonce {
  nonce     String   @id
  userId    String?
  token     String?  @db.Text
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("desktop_login_nonces")
}

// ──────────────────────────────────────────────────────────
// REPORTS / SITE BANNER (admin)
// ──────────────────────────────────────────────────────────

model Report {
  id           String    @id @default(uuid())
  reporterId   String
  targetType   String // 'combo' | 'comment'
  targetId     String
  reason       String?
  status       String    @default("pending") // 'pending' | 'resolved' | 'dismissed'
  createdAt    DateTime  @default(now())
  resolvedAt   DateTime?
  resolvedById String?

  reporter   User  @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  resolvedBy User? @relation("Resolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([targetType, targetId])
  @@map("reports")
}

model SiteBanner {
  id        Int      @id @default(autoincrement())
  enabled   Boolean  @default(false)
  message   String   @default("")
  variant   String   @default("info") // 'info' | 'warning' | 'announcement'
  updatedAt DateTime @updatedAt

  @@map("site_banner")
}
